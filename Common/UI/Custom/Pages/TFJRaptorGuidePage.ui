    TextButton #TFJRaptorGuidePreviousButton {
      Anchor: (Left: 36, Top: 398, Width: 82, Height: 22);
      Text: "Prev";
      Style: @TFJGuideButton;
    }

    TextButton #TFJRaptorGuideNextButton {
      Anchor: (Left: 128, Top: 398, Width: 82, Height: 22);
      Text: "Next";
      Style: @TFJGuideButton;
    }

    TextButton #TFJRaptorGuideCloseButton {
      Anchor: (Right: 36, Top: 398, Width: 82, Height: 22);
