    }
    Group #TFJIncubatorIconBlack {
      Anchor: (Left: 18, Top: 21, Width: 40, Height: 40);
      Background: (TexturePath: "EggIcons/TFJ_Raptor_Egg_Black.png");
      Visible: false;
    }
    Group #TFJIncubatorIconGold {
      Anchor: (Left: 18, Top: 21, Width: 40, Height: 40);
      Background: (TexturePath: "EggIcons/TFJ_Raptor_Egg_Gold.png");
      Visible: false;
    }
    Group #TFJIncubatorIconViolet {
      Anchor: (Left: 18, Top: 21, Width: 40, Height: 40);
      Background: (TexturePath: "EggIcons/TFJ_Raptor_Egg_Violet.png");
      Visible: false;
    }
    Group #TFJIncubatorIconEmerald {
      Anchor: (Left: 18, Top: 21, Width: 40, Height: 40);
      Background: (TexturePath: "EggIcons/TFJ_Raptor_Egg_Emerald.png");
      Visible: false;
    }
    Group #TFJIncubatorIconAmber {
      Anchor: (Left: 18, Top: 21, Width: 40, Height: 40);
      Background: (TexturePath: "EggIcons/TFJ_Raptor_Egg_Amber.png");
      Visible: false;
    }
    Group #TFJIncubatorIconRose {
      Anchor: (Left: 18, Top: 21, Width: 40, Height: 40);
      Background: (TexturePath: "EggIcons/TFJ_Raptor_Egg_Rose.png");
      Visible: false;
    }
    Group #TFJIncubatorIconJade {
      Anchor: (Left: 18, Top: 21, Width: 40, Height: 40);
      Background: (TexturePath: "EggIcons/TFJ_Raptor_Egg_Jade.png");
      Visible: false;
    }
    Group #TFJIncubatorIconIvory {
      Anchor: (Left: 18, Top: 21, Width: 40, Height: 40);
      Background: (TexturePath: "EggIcons/TFJ_Raptor_Egg_Ivory.png");
      Visible: false;
    }
    Group #TFJIncubatorIconAzure {
      Anchor: (Left: 18, Top: 21, Width: 40, Height: 40);
      Background: (TexturePath: "EggIcons/TFJ_Raptor_Egg_Azure.png");
      Visible: false;
    }
    Group #TFJIncubatorIconCrimson {
