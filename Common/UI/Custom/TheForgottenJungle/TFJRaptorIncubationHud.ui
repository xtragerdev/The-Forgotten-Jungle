Group #TFJRaptorIncubationHudRoot {
  Anchor: (Left: 0, Right: 0, Top: 0, Bottom: 0);
  Background: (Color: #000000(0));

  Group #TFJRaptorIncubationHud {
    Anchor: (Bottom: 172, Width: 342, Height: 86);
    Background: (TexturePath: "../Common/ContainerPanelPatch.png", Border: 4);
    Visible: false;

    Group #TFJIncubatorIconSlot {
      Anchor: (Left: 12, Top: 15, Width: 52, Height: 52);
      Background: #000000(0);
    }

    Group #TFJIncubatorIconRed {
      Anchor: (Left: 18, Top: 21, Width: 40, Height: 40);
      Background: (TexturePath: "EggIcons/TFJ_Raptor_Egg_Red.png");
      Visible: false;
    }
    Group #TFJIncubatorIconBlue {
      Anchor: (Left: 18, Top: 21, Width: 40, Height: 40);
      Background: (TexturePath: "EggIcons/TFJ_Raptor_Egg_Blue.png");
      Visible: false;
    }
    Group #TFJIncubatorIconYellow {
      Anchor: (Left: 18, Top: 21, Width: 40, Height: 40);
